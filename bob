local function cleanName(name)
    local n = name:lower():gsub("[^%w_%- ]", "")
    n = n:match("^%s*(.-)%s*$")
    if n == "" then return nil end
    return n
end

local function savePath(name)
    return SAVE_FOLDER .. "/" .. name .. ".json"
end

local function persist(name, data)
    pcall(function()
        if writefile then
            if makefolder and isfolder and not isfolder(SAVE_FOLDER) then
                makefolder(SAVE_FOLDER)
            end
            writefile(savePath(name), HttpService:JSONEncode(data))
        end
    end)
end

local function fetchSave(name)
    if saves[name] then return saves[name] end
    local ok, data = pcall(function()
        if readfile and isfile and isfile(savePath(name)) then
            return HttpService:JSONDecode(readfile(savePath(name)))
        end
    end)
    if ok and data then
        saves[name] = data
        return data
    end
    return nil
end

local function deleteSave(name)
    if PROTECTED_SAVES[name] then return false end
    local existed = saves[name] ~= nil
    saves[name] = nil
    pcall(function()
        if isfile and delfile and isfile(savePath(name)) then
            delfile(savePath(name))
            existed = true
        end
    end)
    return existed
end

local function deleteAllSaves()
    local names = {}
    for name in pairs(saves) do
        names[name] = true
    end
    pcall(function()
        if listfiles and isfolder and isfolder(SAVE_FOLDER) then
            for _, path in ipairs(listfiles(SAVE_FOLDER)) do
                local fileName = path:match("([^/\\]+)%.json$")
                if fileName then
                    names[fileName] = true
                end
            end
        end
    end)
    local count = 0
    for name in pairs(names) do
        if deleteSave(name) then
            count = count + 1
        end
    end
    return count
end

local function findTool(toolName)
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local lowered = toolName:lower()

    for _, container in ipairs({ backpack, character }) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") and item.Name:lower() == lowered then
                    return item
                end
            end
        end
    end
    for _, container in ipairs({ backpack, character }) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") and item.Name:lower():find(lowered, 1, true) then
                    return item
                end
            end
        end
    end
    return nil
end

local function getEvent(toolName)
    local tool = findTool(toolName)
    return tool and tool:FindFirstChild("Event", true)
end

local function holdAllTools(character)
    for _, toolName in ipairs(TOOL_NAMES) do
        local tool = findTool(toolName)
        if tool and tool.Parent ~= character then
            pcall(function()
                tool.Parent = character
            end)
        end
    end
end

-- fly
local function startFlyer(root)
    local flyer = { pos = root.Position, target = root.Position }
    flyer.connection = RunService.Heartbeat:Connect(function(dt)
        local delta = flyer.target - flyer.pos
        local distance = delta.Magnitude
        if distance > 0.01 then
            flyer.pos = flyer.pos + delta.Unit * math.min(distance, FLY_SPEED * dt)
        end
        root.CFrame = CFrame.new(flyer.pos)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)
    return flyer
end

local function flyTo(flyer, destination)
    flyer.target = destination
    local startTime = os.clock()
    while (flyer.pos - destination).Magnitude > 0.5 and os.clock() - startTime < 20 do
        RunService.Heartbeat:Wait()
    end
    flyer.pos = destination
end

