local function colorFromHex(hex)
    if not hex then return nil end
    local ok, color = pcall(Color3.fromHex, hex)
    return ok and color or nil
end

local function myBrickFolder()
    local bricks = workspace:FindFirstChild("Bricks")
    return bricks and bricks:FindFirstChild(LocalPlayer.Name)
end

local function brickCount()
    local folder = myBrickFolder()
    return folder and #folder:GetChildren() or 0
end

local function newestBrick()
    local folder = myBrickFolder()
    if not folder then return nil end
    local children = folder:GetChildren()
    for i = #children, 1, -1 do
        local child = children[i]
        if child:IsA("BasePart") and child.Name == BRICK_NAME then
            return child
        end
    end
    return nil
end

local function waitForNewBrick(before, timeout)
    local startTime = os.clock()
    while os.clock() - startTime < timeout do
        if brickCount() > before then
            return true
        end
        RunService.Heartbeat:Wait()
    end
    return brickCount() > before
end

local function paintBrick(paintEvent, brick, color, materialName, position)
    for i = 1, PAINT_REPEATS do
        pcall(function()
            paintEvent:FireServer(brick, Enum.NormalId.Left, position, "both 🤝", color, materialName, "")
        end)
        if i < PAINT_REPEATS then
            RunService.Heartbeat:Wait()
