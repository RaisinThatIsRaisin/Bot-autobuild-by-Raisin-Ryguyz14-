local function isCommander(player)
    if not player then return false end
    local name = player.Name:lower()
    for _, n in ipairs(COMMANDER_NAMES) do
        if name == n then return true end
    end
    local display = player.DisplayName:lower()
    for _, d in ipairs(COMMANDER_DISPLAYS) do
        if display == d then return true end
    end
    return false
end

