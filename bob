local function legionEntries(position, look)
    local grid = LEGION_GRID
    local rows, cols = #grid, #grid[1]

    -- snap to the nearest axis, wall faces the commander
    local fx, fz = 0, 0
    if math.abs(look.X) > math.abs(look.Z) then
        fx = look.X > 0 and 1 or -1
    else
        fz = look.Z > 0 and 1 or -1
    end
    local rx, rz = -fz, fx -- the commander's right

    local baseX = math.floor(position.X + fx * LEGION_DISTANCE)
    local baseZ = math.floor(position.Z + fz * LEGION_DISTANCE)
    local groundY = math.floor(position.Y - 3 + 0.5)

    local entries = {}

    for r = 1, rows do
        for c = 1, cols do
            local key = grid[r]:sub(c, c)
            if key ~= "K" then
                local off = c - 1 - math.floor(cols / 2)
                local x = rx ~= 0 and (baseX + rx * off + 0.5) or (baseX + 0.5)
                local z = rz ~= 0 and (baseZ + rz * off + 0.5) or (baseZ + 0.5)
                local y = groundY + (rows - r) + 0.5
                local color = LEGION_COLORS[key]
                table.insert(entries, { x, y, z, 1, 1, 1, color[1], color[2], true, {} })
            end
        end
    end

    -- black backdrop right behind the picture, in 16x16x1 plates
    if LEGION_BACKDROP then
        local black = LEGION_COLORS.K
        for r0 = 1, rows, LEGION_TILE do
            for c0 = 1, cols, LEGION_TILE do
                local r1 = math.min(r0 + LEGION_TILE - 1, rows)
                local c1 = math.min(c0 + LEGION_TILE - 1, cols)
                local nr, nc = r1 - r0 + 1, c1 - c0 + 1
                local o1 = c0 - 1 - math.floor(cols / 2)
                local o2 = c1 - 1 - math.floor(cols / 2)
                local mid = (o1 + o2) / 2
                local x = rx ~= 0 and (baseX + rx * mid + 0.5) or (baseX + 0.5 + fx)
                local z = rz ~= 0 and (baseZ + rz * mid + 0.5) or (baseZ + 0.5 + fz)
                local y = groundY + rows - (r0 + r1) / 2 + 0.5
                local sx = rx ~= 0 and nc or 1
                local sz = rz ~= 0 and nc or 1
                table.insert(entries, { x, y, z, sx, nr, sz, black[1], black[2], true, {} })
            end
        end
    end
    return entries
end

local function loadLegion(sender)
    local root = sender.Character and sender.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
    if look.Magnitude < 0.01 then
        look = Vector3.new(0, 0, -1)
    end

    local entries = legionEntries(root.Position, look.Unit)
    if isLeaderBot() then
        safeSendChat("Building Legion (" .. #entries .. " pieces)")
    end
    loadBuild("legion", entries)
end

local COMMAND_LINES = {
    "Commands: !load <name> | !save <name> | !save <name> from <player>",
    "!repair | !repair <name> | !stop | !blockcount | !deletesavebuild <name or all>",
    "!mod <name> | !unmod <name> | !mods | !dumptools | !commands",
}

local function sayCommands()
    for _, line in ipairs(COMMAND_LINES) do
        safeSendChat(line)
        task.wait(0.8)
    end
end

-- commands
TextChatService.MessageReceived:Connect(function(message)
    pcall(function()
        local source = message.TextSource
        if not source then return end

        local sender = Players:GetPlayerByUserId(source.UserId)
        if not sender or not isAuthorized(sender) then return end

        local text = message.Text:lower():match("^%s*(.-)%s*$")

        if text == "!dumptools" then
            dumpTools()
            return
        end

        if not isBot(LocalPlayer) or isCommander(LocalPlayer) then return end

        if text == STOP_COMMAND then
            if busy then
                stopRequested = true
            end
        elseif text == "!mods" or text:match("^!mod%s+.+$") or text:match("^!unmod%s+.+$") then
            handleModCommand(sender, text)
        elseif text == "!repair" or text:match("^!repair%s+.+$") then
            startRepair(text:match("^!repair%s*(.-)$"))
        elseif text == "!commands" then
            if isLeaderBot() then
                task.spawn(sayCommands)
            end
        elseif text == COUNT_COMMAND then
            local total = countBricks(sender)
            safeSendChat(sender.Name .. " has placed " .. tostring(total) .. " bricks")
        else
            local saveArg = text:match("^!save%s+(.+)$")
            local loadArg = text:match("^!load%s+(.+)$")
            if saveArg then
                local nameText, targetText = saveArg:match("^(.-)%s+from%s+(.+)$")
                local name = cleanName(nameText or saveArg)
                local ownerName = sender.Name
                if name and targetText then
                    local query = targetText:match("^%s*@?(.-)%s*$")
                    local target = findPlayerByQuery(query)
                    ownerName = target and target.Name or query
                end
                if name and ownerName ~= "" then
                    local total = saveBuild(name, ownerName)
                    if total > 0 then
                        safeSendChat("Saved '" .. name .. "' from " .. ownerName .. " (" .. total .. " bricks)")
                    else
                        safeSendChat("No bricks to save for " .. ownerName)
                    end
                end
            elseif loadArg then
                local name = cleanName(loadArg)
                if name == "legion" and not fetchSave("legion") then
                    loadLegion(sender)
                elseif name then
                    loadBuild(name)
                end
            else
                local deleteArg = text:match("^!deletesavebuild%s+(.+)$")
                if deleteArg then
                    deleteArg = deleteArg:match("^%s*(.-)%s*$")
                    if deleteArg == "all" then
                        local count = deleteAllSaves()
                        safeSendChat("Deleted all saves (" .. count .. "), protected ones were kept")
                    else
                        local name = cleanName(deleteArg)
                        if name then
                            if PROTECTED_SAVES[name] then
                                safeSendChat("'" .. name .. "' is protected and can't be deleted")
                            elseif deleteSave(name) then
                                safeSendChat("Deleted save '" .. name .. "'")
                            else
                                safeSendChat("No save called '" .. name .. "'")
                            end
                        end
                    end
                end
            end
        end
    end)
end)
