local function safeSendChat(messageText)
    pcall(function()
        local textChannels = TextChatService:FindFirstChild("TextChannels")
        if textChannels then
            local generalChannel = textChannels:FindFirstChild("RBXGeneral")
            if generalChannel then
                generalChannel:SendAsync(messageText)
                return
            end
        end
        if TextChatService:FindFirstChild("ChatInputBarConfiguration") then
            local targetChannel = TextChatService.ChatInputBarConfiguration.TargetTextChannel
            if targetChannel then
                targetChannel:SendAsync(messageText)
            end
        end
    end)
end

local function isCommander(player)
    if not player then return false end
    local name = player.Name:lower()
    for _, n in ipairs(COMMANDER_NAMES) do
        if name == n then return true end
    end
    local display = player.DisplayName:lower()
    for _, d in ipairs(COMMANDER_DISPLAYS) do
        if display == d then return true end
    end
    return false
end

local MODS_FILE = "AutoBuildMods.json"
local mods = {}

local function saveMods()
    pcall(function()
        if writefile then
            local list = {}
            for name in pairs(mods) do
                table.insert(list, name)
            end
            writefile(MODS_FILE, HttpService:JSONEncode(list))
        end
    end)
end

local function loadMods()
    pcall(function()
        if readfile and isfile and isfile(MODS_FILE) then
            for _, name in ipairs(HttpService:JSONDecode(readfile(MODS_FILE))) do
                mods[tostring(name):lower()] = true
            end
        end
