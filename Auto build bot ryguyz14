local function isMod(player)
    return player ~= nil and mods[player.Name:lower()] == true
end

local function isAuthorized(player)
    return isCommander(player) or isMod(player)
end

local function botIndex(player)
    if not player then return nil end
    local name = player.Name:lower()
    local display = player.DisplayName:lower()
    for i, botName in ipairs(BOT_NAMES) do
        local b = botName:lower()
        if name == b or display == b then
            return i
        end
    end
    return nil
end

local function isBot(player)
    return botIndex(player) ~= nil
end

local function brickRoot()
    return workspace:FindFirstChild("Bricks") or workspace
end

local function cleanName(name)
    local n = name:lower():gsub("[^%w_%- ]", "")
    n = n:match("^%s*(.-)%s*$")
    if n == "" then return nil end
    return n
end

local function savePath(name)
    return SAVE_FOLDER .. "/" .. name .. ".json"
end

local function persist(name, data)
    pcall(function()
        if writefile then
            if makefolder and isfolder and not isfolder(SAVE_FOLDER) then
                makefolder(SAVE_FOLDER)
            end
            writefile(savePath(name), HttpService:JSONEncode(data))
        end
    end)
end

local function fetchSave(name)
    if saves[name] then return saves[name] end
    local ok, data = pcall(function()
        if readfile and isfile and isfile(savePath(name)) then
            return HttpService:JSONDecode(readfile(savePath(name)))
        end
    end)
    if ok and data then
        saves[name] = data
        return data
    end
    return nil
end

local function deleteSave(name)
    if PROTECTED_SAVES[name] then return false end
    local existed = saves[name] ~= nil
    saves[name] = nil
    pcall(function()
        if isfile and delfile and isfile(savePath(name)) then
            delfile(savePath(name))
            existed = true
        end
    end)
    return existed
end

local function deleteAllSaves()
    local names = {}
    for name in pairs(saves) do
        names[name] = true
    end
    pcall(function()
        if listfiles and isfolder and isfolder(SAVE_FOLDER) then
            for _, path in ipairs(listfiles(SAVE_FOLDER)) do
                local fileName = path:match("([^/\\]+)%.json$")
                if fileName then
                    names[fileName] = true
                end
            end
        end
    end)
    local count = 0
    for name in pairs(names) do
        if deleteSave(name) then
            count = count + 1
        end
    end
    return count
end

local function findTool(toolName)
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local lowered = toolName:lower()

    for _, container in ipairs({ backpack, character }) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") and item.Name:lower() == lowered then
                    return item
                end
            end
        end
    end
    for _, container in ipairs({ backpack, character }) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") and item.Name:lower():find(lowered, 1, true) then
                    return item
                end
            end
        end
    end
    return nil
end

local function getEvent(toolName)
    local tool = findTool(toolName)
    return tool and tool:FindFirstChild("Event", true)
end

local function holdAllTools(character)
    for _, toolName in ipairs(TOOL_NAMES) do
        local tool = findTool(toolName)
        if tool and tool.Parent ~= character then
            pcall(function()
                tool.Parent = character
            end)
        end
    end
end

-- fly
local function startFlyer(root)
    local flyer = { pos = root.Position, target = root.Position }
    flyer.connection = RunService.Heartbeat:Connect(function(dt)
        local delta = flyer.target - flyer.pos
        local distance = delta.Magnitude
        if distance > 0.01 then
            flyer.pos = flyer.pos + delta.Unit * math.min(distance, FLY_SPEED * dt)
        end
        root.CFrame = CFrame.new(flyer.pos)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)
    return flyer
end

local function flyTo(flyer, destination)
    flyer.target = destination
    local startTime = os.clock()
    while (flyer.pos - destination).Magnitude > 0.5 and os.clock() - startTime < 20 do
        RunService.Heartbeat:Wait()
    end
    flyer.pos = destination
end

local ARM_AND_HEAD_PARTS = {
    "Head", "Left Arm", "Right Arm", "LeftHand", "RightHand",
    "LeftLowerArm", "RightLowerArm", "LeftUpperArm", "RightUpperArm",
}

local function startNoclip(character)
    return RunService.Stepped:Connect(function()
        for _, part in ipairs(character:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)
end

local function restoreCollisions(character)
    if not character then return end
    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") then
            part.CanCollide = not table.find(ARM_AND_HEAD_PARTS, part.Name)
        end
    end
end

local CELL = 2

local function cellOf(n)
    return math.floor(n / CELL)
end

local function cellKey(x, y, z)
    return x .. "," .. y .. "," .. z
end

local function sortedDims(size)
    local d = { size.X, size.Y, size.Z }
    table.sort(d)
    return d
end

local function sameSize(a, b)
    local da, db = sortedDims(a), sortedDims(b)
    for i = 1, 3 do
        if math.abs(da[i] - db[i]) > SIZE_TOLERANCE then
            return false
        end
    end
    return true
end

local function scanExistingBricks()
    local index = {}
    local brickName = BRICK_NAME:lower()
    for i, d in ipairs(brickRoot():GetDescendants()) do
        if d:IsA("BasePart") and d.Name:lower() == brickName then
            local p = d.Position
            local key = cellKey(cellOf(p.X), cellOf(p.Y), cellOf(p.Z))
            local list = index[key]
            if not list then
                list = {}
                index[key] = list
            end
            table.insert(list, { pos = p, size = d.Size, part = d })
        end
        if i % 2000 == 0 then task.wait() end
    end
    return index
end

local function brickExists(index, entry)
    local center = Vector3.new(entry[1], entry[2], entry[3])
    local size = Vector3.new(entry[4], entry[5], entry[6])
    local cx, cy, cz = cellOf(center.X), cellOf(center.Y), cellOf(center.Z)

    for dx = -1, 1 do
        for dy = -1, 1 do
            for dz = -1, 1 do
                local list = index[cellKey(cx + dx, cy + dy, cz + dz)]
                if list then
                    for _, b in ipairs(list) do
                        if (b.pos - center).Magnitude <= POSITION_TOLERANCE and sameSize(b.size, size) then
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

-- which bricks are gone
local function findMissing(data)
    local existing = scanExistingBricks()
    local missing, present = {}, 0
    for _, entry in ipairs(data) do
        if brickExists(existing, entry) then
            present = present + 1
        else
            table.insert(missing, entry)
        end
    end
    return missing, present
end

local function getBotsInServer()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        local idx = botIndex(plr)
        if idx and not isCommander(plr) then
            table.insert(list, { plr = plr, idx = idx })
        end
    end
    table.sort(list, function(a, b) return a.idx < b.idx end)
    return list
end

local function brickOrder(a, b)
    local ax, bx = math.floor(a[1] / SPLIT_CHUNK), math.floor(b[1] / SPLIT_CHUNK)
    if ax ~= bx then return ax < bx end
    local az, bz = math.floor(a[3] / SPLIT_CHUNK), math.floor(b[3] / SPLIT_CHUNK)
    if az ~= bz then
        if ax % 2 == 0 then return az < bz else return az > bz end
    end
    if a[2] ~= b[2] then return a[2] < b[2] end
    if a[1] ~= b[1] then return a[1] < b[1] end
    return a[3] < b[3]
end

-- each bot builds its own chunk
local function myShare(data)
    local bots = getBotsInServer()
    local total = math.max(#bots, 1)
    local rank = 1
    for i, b in ipairs(bots) do
        if b.plr == LocalPlayer then rank = i end
    end

    local ordered = table.clone(data)
    table.sort(ordered, brickOrder)

    local perBot = math.ceil(#ordered / total)
    local share = {}
    for i = (rank - 1) * perBot + 1, math.min(rank * perBot, #ordered) do
        table.insert(share, ordered[i])
    end
    return share, rank, total
end

local PAINT_NAMES = {
    SmoothPlastic = "smooth", Plastic = "plastic", CeramicTiles = "tiles",
    Brick = "bricks", WoodPlanks = "planks", Ice = "ice", Grass = "grass",
    Sand = "sand", Snow = "snow", Glass = "glass", Wood = "wood", Slate = "stone",
    Pebble = "pebble", Marble = "marble", Granite = "granite", DiamondPlate = "steel",
    Metal = "metal", Asphalt = "asphalt", Concrete = "concrete", Pavement = "pavement",
    Neon = "neon",
}

local function colorFromHex(hex)
    if not hex then return nil end
    local ok, color = pcall(Color3.fromHex, hex)
    return ok and color or nil
end

local function myBrickFolder()
    local bricks = workspace:FindFirstChild("Bricks")
    return bricks and bricks:FindFirstChild(LocalPlayer.Name)
end

local function brickCount()
    local folder = myBrickFolder()
    return folder and #folder:GetChildren() or 0
end

local function newestBrick()
    local folder = myBrickFolder()
    if not folder then return nil end
    local children = folder:GetChildren()
    for i = #children, 1, -1 do
        local child = children[i]
        if child:IsA("BasePart") and child.Name == BRICK_NAME then
            return child
        end
    end
    return nil
end

local function waitForNewBrick(before, timeout)
    local startTime = os.clock()
    while os.clock() - startTime < timeout do
        if brickCount() > before then
            return true
        end
        RunService.Heartbeat:Wait()
    end
    return brickCount() > before
end

local function paintBrick(paintEvent, brick, color, materialName, position)
    for i = 1, PAINT_REPEATS do
        pcall(function()
            paintEvent:FireServer(brick, Enum.NormalId.Left, position, "both 🤝", color, materialName, "")
        end)
        if i < PAINT_REPEATS then
            RunService.Heartbeat:Wait()
        end
    end
end

local function sprayBrick(paintEvent, brick, face, text, color, position)
    pcall(function()
        paintEvent:FireServer(brick, face, position, "both 🤝", color, "spray", text)
    end)
end

local function resizeBrick(shapeEvent, position, targetSize)
    local counts = {
        math.floor(targetSize.X - 1),
        math.floor(targetSize.Y - 1),
        math.floor(targetSize.Z - 1),
    }
    local faces = { Enum.NormalId.Right, Enum.NormalId.Top, Enum.NormalId.Back }

    local function growOnce(face)
        local brick = newestBrick()
        local waited = os.clock()
        while not brick and os.clock() - waited < 0.3 do
            RunService.Heartbeat:Wait()
            brick = newestBrick()
        end
        if not brick then return false end

        local oldSize = brick.Size
        pcall(function()
            shapeEvent:FireServer(brick, face, position, "increase")
        end)

        local startTime = os.clock()
        while os.clock() - startTime < RESIZE_TIMEOUT do
            RunService.Heartbeat:Wait()
            local now = newestBrick()
            if now ~= brick or (now and now.Size ~= oldSize) then
                break
            end
        end
        return true
    end

    for round = 1, math.max(counts[1], counts[2], counts[3]) do
        if stopRequested then return false end
        for axis = 1, 3 do
            if round <= counts[axis] then
                if not growOnce(faces[axis]) then return false end
            end
        end
    end
    return true
end

-- 4x4x4 on the grid = one build call, anything else gets resized
local function placeBrick(entry, tools, flyer, root)
    local center = Vector3.new(entry[1], entry[2], entry[3])
    local size = Vector3.new(entry[4], entry[5], entry[6])
    local color = colorFromHex(entry[7])
    local materialName = PAINT_NAMES[entry[8]] or "smooth"
    local canCollide = entry[9] ~= false
    local sprays = entry[10] or {}

    local function mod4(n)
        return ((math.floor(n + 0.5) % 4) + 4) % 4
    end
    local is4 = math.floor(size.X + 0.5) == 4 and math.floor(size.Y + 0.5) == 4 and math.floor(size.Z + 0.5) == 4
    local onGrid = mod4(center.X) == 2 and mod4(center.Y) == 2 and mod4(center.Z) == 2
    local needsResize = not (is4 and onGrid)

    local placePosition = needsResize and (center - size / 2 + Vector3.new(0.5, 0.5, 0.5)) or center

    local mode
    if canCollide then
        mode = needsResize and "detailed" or "normal"
    else
        mode = needsResize and "detailed nocollide" or "nocollide"
    end

    if ALWAYS_FLY or needsResize or (flyer.pos - placePosition).Magnitude > REACH then
        flyTo(flyer, placePosition + Vector3.new(0, BUILD_HEIGHT_OFFSET, 0))
    end

    local before = brickCount()
    local retryDelay = math.max(0.04, LocalPlayer:GetNetworkPing() * 2 + 0.03)
    if not canCollide then
        retryDelay = retryDelay * 2
    end
    local attempts = 0
    local appeared = false
    repeat
        pcall(function()
            tools.build:FireServer(workspace.Terrain, Enum.NormalId.Top, placePosition, mode)
        end)
        attempts = attempts + 1
        appeared = waitForNewBrick(before, retryDelay)
    until appeared or attempts >= MAX_PLACE_ATTEMPTS or stopRequested

    if not appeared then
        return false
    end

    local brick = newestBrick()
    if not brick then return false end

    if color then
        paintBrick(tools.paint, brick, color, materialName, root.Position)
    end

    for _, spray in ipairs(sprays) do
        local face = Enum.NormalId[spray[1]]
        local sprayColor = colorFromHex(spray[3]) or Color3.new(1, 1, 1)
        if face then
            task.wait(0.03)
            sprayBrick(tools.paint, brick, face, spray[2] or "", sprayColor, root.Position)
        end
    end

    if not canCollide and color then
        task.wait(0.03)
        pcall(function()
            tools.paint:FireServer(brick, Enum.NormalId.Back, root.Position, "material", color, "collide", "")
        end)
    end

    if needsResize and size ~= Vector3.new(1, 1, 1) then
        resizeBrick(tools.shape, root.Position, size)
        RunService.Heartbeat:Wait()
    end

    local final = newestBrick()
    if needsResize and (not final or (final.Size - size).Magnitude > 0.1) then
        if final and tools.delete then
            pcall(function()
                tools.delete:FireServer(final, root.Position)
            end)
            task.wait(0.1)
        end
        return false
    end
    return true
end

local lastBuild = nil

local function sameColor(a, b)
    return math.abs(a.R - b.R) < COLOR_TOLERANCE
        and math.abs(a.G - b.G) < COLOR_TOLERANCE
        and math.abs(a.B - b.B) < COLOR_TOLERANCE
end

-- returns ok / paint / wrong / missing
local function inspectBrick(index, entry)
    local center = Vector3.new(entry[1], entry[2], entry[3])
    local size = Vector3.new(entry[4], entry[5], entry[6])
    local wantColor = colorFromHex(entry[7])
    local wantMaterial = entry[8]
    local wantSolid = entry[9] ~= false
    local cx, cy, cz = cellOf(center.X), cellOf(center.Y), cellOf(center.Z)

    local best, bestDistance = nil, math.huge
    local wrongSize = nil

    for dx = -1, 1 do
        for dy = -1, 1 do
            for dz = -1, 1 do
                local list = index[cellKey(cx + dx, cy + dy, cz + dz)]
                if list then
                    for _, b in ipairs(list) do
                        local distance = (b.pos - center).Magnitude
                        if distance <= POSITION_TOLERANCE and b.part.Parent then
                            if sameSize(b.size, size) then
                                if distance < bestDistance then
                                    best, bestDistance = b, distance
                                end
                            elseif not wrongSize then
                                wrongSize = b
                            end
                        end
                    end
                end
            end
        end
    end

    if best then
        local part = best.part
        local goodColor = not wantColor or sameColor(part.Color, wantColor)
        local goodMaterial = not wantMaterial or part.Material.Name == wantMaterial
        local goodSolid = wantSolid or not part.CanCollide
        if goodColor and goodMaterial and goodSolid then
            return "ok", part
        end
        return "paint", part
    end
    if wrongSize then
        return "wrong", wrongSize.part
    end
    return "missing", nil
end

local function fixBrick(status, part, entry, tools, flyer, root)
    if status == "missing" then
        return placeBrick(entry, tools, flyer, root)

    elseif status == "wrong" then
        if part and part.Parent and part.Parent == myBrickFolder() and tools.delete then
            flyTo(flyer, part.Position + Vector3.new(0, BUILD_HEIGHT_OFFSET, 0))
            pcall(function()
                tools.delete:FireServer(part, root.Position)
            end)
            task.wait(0.15)
        end
        return placeBrick(entry, tools, flyer, root)

    elseif status == "paint" and part then
        flyTo(flyer, part.Position + Vector3.new(0, BUILD_HEIGHT_OFFSET, 0))
        local color = colorFromHex(entry[7])
        if color then
            paintBrick(tools.paint, part, color, PAINT_NAMES[entry[8]] or "smooth", root.Position)

            local wantSolid = entry[9] ~= false
            if not wantSolid and part.CanCollide then
                task.wait(0.03)
                pcall(function()
                    tools.paint:FireServer(part, Enum.NormalId.Back, root.Position, "material", color, "collide", "")
                end)
            end
        end
        task.wait(0.1)
        return true
    end
    return false
end

local function repairPass(data, tools, flyer, root)
    local index = scanExistingBricks()
    local fixed = 0
    for _, entry in ipairs(data) do
        if stopRequested then break end
        local status, part = inspectBrick(index, entry)
        if status ~= "ok" then
            if fixBrick(status, part, entry, tools, flyer, root) then
                fixed = fixed + 1
            end
        end
    end
    return fixed
end

local function countProblems(data)
    local index = scanExistingBricks()
    local counts = { missing = 0, wrong = 0, paint = 0 }
    for _, entry in ipairs(data) do
        local status = inspectBrick(index, entry)
        if status ~= "ok" then
            counts[status] = counts[status] + 1
        end
    end
    return counts
end

local busy = false

-- repairOnly skips placing and just fixes
local function loadBuild(name, presetData, repairOnly)
    if busy then return end
    busy = true
    stopRequested = false

    local flyer, noclip, humanoid, character
    local ok, err = pcall(function()
        local data = presetData or fetchSave(name)
        if not data then
            safeSendChat("No save called '" .. name .. "'")
            return
        end

        character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        humanoid = character and character:FindFirstChildOfClass("Humanoid")

        holdAllTools(character)
        local tools = {
            build = getEvent("Build"),
            paint = getEvent("Paint"),
            shape = getEvent("Shape"),
            delete = getEvent("Delete"),
        }
        if not (root and tools.build and tools.paint and tools.shape) then
            safeSendChat("Does not have tools to do load!")
            return
        end

        local startPosition = root.Position
        local placed, already = 0, 0

        if humanoid then humanoid.PlatformStand = true end
        noclip = startNoclip(character)
        flyer = startFlyer(root)

        local share, rank, totalBots = myShare(data)
        lastBuild = { name = name, data = data }
        data = share

        local missing, present = findMissing(data)
        already = present
        if repairOnly then
            missing = {}
        end

        for pass = 1, MAX_LOAD_PASSES do
            if #missing == 0 or stopRequested then break end

            local placedThisPass = 0
            for _, entry in ipairs(missing) do
                if stopRequested then break end

                local success = placeBrick(entry, tools, flyer, root)
                if not success and not stopRequested then
                    success = placeBrick(entry, tools, flyer, root)
                end
                if success then
                    placed = placed + 1
                    placedThisPass = placedThisPass + 1
                end
            end

            task.wait(0.3)
            missing = findMissing(data)

            if stopRequested or placedThisPass == 0 then break end
        end

        local fixed = 0
        for _ = 1, VERIFY_CHECKS do
            if stopRequested then break end
            task.wait(0.3)
            fixed = fixed + repairPass(data, tools, flyer, root)
        end

        task.wait(0.3)
        local problems = countProblems(data)
        local failed = problems.missing + problems.wrong + problems.paint

        flyTo(flyer, startPosition)

        if stopRequested then
            safeSendChat("Stopped '" .. name .. "' (part " .. rank .. "/" .. totalBots .. "): placed " .. placed)
        elseif repairOnly then
            safeSendChat("Repaired '" .. name .. "' (part " .. rank .. "/" .. totalBots .. "): fixed " .. fixed
                .. ", still wrong " .. failed)
        else
            safeSendChat("Loaded '" .. name .. "' (part " .. rank .. "/" .. totalBots .. "): placed " .. placed
                .. ", already there " .. already .. ", fixed on re-check " .. fixed .. ", failed " .. failed)
        end
    end)

    pcall(function()
        if flyer then flyer.connection:Disconnect() end
        if noclip then noclip:Disconnect() end
        if humanoid then humanoid.PlatformStand = false end
        restoreCollisions(character)
    end)

    if not ok then
        warn("loadBuild error: " .. tostring(err))
        safeSendChat("Load failed: " .. tostring(err))
    end
    busy = false
end

local function countBricks(owner)
    local ownerName = owner.Name:lower()
    local brickName = BRICK_NAME:lower()
    local count = 0

    for i, descendant in ipairs(brickRoot():GetDescendants()) do
        if descendant.Name:lower() == brickName then
            local parent = descendant.Parent
            if parent and parent.Name:lower() == ownerName then
                count = count + 1
            end
        end
        if i % 2000 == 0 then
            task.wait()
        end
    end
    return count
end

local function collectSprays(brick)
    local sprays = {}
    for _, child in ipairs(brick:GetChildren()) do
        if child.Name == "Spray" then
            local label = child:FindFirstChild("Label")
            local ok, face = pcall(function()
                return child.Face
            end)
            if label and ok and face then
                table.insert(sprays, { face.Name, label.Text, label.TextColor3:ToHex() })
            end
        end
    end
    return sprays
end

local function round2(n)
    return math.floor(n * 100 + 0.5) / 100
end

local function saveBuild(name, ownerAccountName)
    local ownerName = ownerAccountName:lower()
    local brickName = BRICK_NAME:lower()
    local data = {}

    for i, descendant in ipairs(brickRoot():GetDescendants()) do
        if descendant:IsA("BasePart") and descendant.Anchored and descendant.Name:lower() == brickName then
            local parent = descendant.Parent
            if parent and parent.Name:lower() == ownerName then
                local p = descendant.Position
                local s = descendant.Size
                table.insert(data, {
                    round2(p.X), round2(p.Y), round2(p.Z),
                    round2(s.X), round2(s.Y), round2(s.Z),
                    descendant.Color:ToHex(),
                    descendant.Material.Name,
                    descendant.CanCollide,
                    collectSprays(descendant),
                })
            end
        end
        if i % 2000 == 0 then
            task.wait()
        end
    end

    if #data == 0 then
        return 0
    end

    saves[name] = data
    persist(name, data)
    return #data
end

local function dumpTools()
    local out = {}
    local function add(line)
        table.insert(out, line)
    end

    local function dumpScript(scr)
        add("---- " .. scr:GetFullName() .. " (" .. scr.ClassName .. ")")
        local ok, source = pcall(function()
            return decompile(scr)
        end)
        add(ok and tostring(source) or ("[could not decompile: " .. tostring(source) .. "]"))
        add("")
    end

    local function dumpTool(tool)
        add("======== TOOL: " .. tool.Name .. " ========")
        for _, d in ipairs(tool:GetDescendants()) do
            if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
                add("REMOTE: " .. d:GetFullName() .. " (" .. d.ClassName .. ")")
            end
        end
        for _, d in ipairs(tool:GetDescendants()) do
            if d:IsA("LocalScript") then
                dumpScript(d)
            end
        end
    end

    local wanted = { build = true, paint = true, shape = true, delete = true }
    for _, container in ipairs({ LocalPlayer.Character, LocalPlayer:FindFirstChildOfClass("Backpack") }) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") and wanted[item.Name:lower()] then
                    dumpTool(item)
                end
            end
        end
    end

    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if gui then
        for _, screen in ipairs(gui:GetChildren()) do
            local n = screen.Name:lower()
            if screen:IsA("ScreenGui") and (n:find("paint") or n:find("shape") or n:find("build") or n:find("color")) then
                add("======== MENU: " .. screen.Name .. " ========")
                for _, d in ipairs(screen:GetDescendants()) do
                    if d:IsA("LocalScript") then
                        dumpScript(d)
                    end
                end
            end
        end
    end

    local result = table.concat(out, "\n")
    if #out == 0 then
        result = "No Build / Paint / Shape tools found on this account."
    end

    pcall(function()
        setclipboard(result)
    end)
    print(result)
    print("---- Tool dump done. It was also copied to your clipboard. ----")

    if isBot(LocalPlayer) then
        safeSendChat("Tools dumped (" .. #result .. " characters)")
    end
end

-- first bot does the talking for mod stuff
local function isLeaderBot()
    local bots = getBotsInServer()
    return bots[1] ~= nil and bots[1].plr == LocalPlayer
end

local function findPlayerByQuery(query)
    local prefix, contains
    for _, plr in ipairs(Players:GetPlayers()) do
        local n, d = plr.Name:lower(), plr.DisplayName:lower()
        if n == query or d == query then
            return plr
        end
        if not prefix and (n:sub(1, #query) == query or d:sub(1, #query) == query) then
            prefix = plr
        end
        if not contains and (n:find(query, 1, true) or d:find(query, 1, true)) then
            contains = plr
        end
    end
    return prefix or contains
end

local function handleModCommand(sender, text)
    local leader = isLeaderBot()

    if text == "!mods" then
        if leader then
            local list = {}
            for name in pairs(mods) do
                table.insert(list, name)
            end
            table.sort(list)
            if #list > 0 then
                safeSendChat("Mods: " .. table.concat(list, ", "))
            else
                safeSendChat("No mods yet")
            end
        end
        return
    end

    if not isCommander(sender) then
        if leader then
            safeSendChat("Only a commander can add or remove mods")
        end
        return
    end

    local addArg = text:match("^!mod%s+(.+)$")
    local removeArg = text:match("^!unmod%s+(.+)$")

    if addArg then
        local query = addArg:match("^%s*@?(.-)%s*$")
        local target = findPlayerByQuery(query)
        if target and (isBot(target) or isCommander(target)) then
            if leader then
                safeSendChat(target.Name .. " is already a commander or bot")
            end
            return
        end
        local accountName = target and target.Name:lower() or query
        if accountName == "" then return end
        mods[accountName] = true
        saveMods()
        if leader then
            safeSendChat(accountName .. " is now a mod")
        end
    elseif removeArg then
        local query = removeArg:match("^%s*@?(.-)%s*$")
        local accountName = query
        if not mods[accountName] then
            local target = findPlayerByQuery(query)
            accountName = target and target.Name:lower() or query
        end
        if mods[accountName] then
            mods[accountName] = nil
            saveMods()
            if leader then
                safeSendChat(accountName .. " is no longer a mod")
            end
        elseif leader then
            safeSendChat(accountName .. " is not a mod")
        end
    end
end

local function startRepair(arg)
    local name = arg and cleanName(arg) or nil
    local build = nil

    if lastBuild and (name == nil or lastBuild.name == name) then
        build = lastBuild
    elseif name then
        local saved = fetchSave(name)
        if saved then
            build = { name = name, data = saved }
        end
    end

    if not build then
        if isLeaderBot() then
            if name then
                safeSendChat("No build called '" .. name .. "' to repair (load it first)")
            else
                safeSendChat("Nothing to repair yet, load a build first")
            end
        end
        return
    end

    loadBuild(build.name, build.data, true)
end

local COMMAND_LINES = {
    "Commands: !load <name> | !save <name> | !save <name> from <player>",
    "!repair | !repair <name> | !stop | !blockcount | !deletesavebuild <name or all>",
    "!mod <name> | !unmod <name> | !mods | !dumptools | !commands",
}

local function sayCommands()
    for _, line in ipairs(COMMAND_LINES) do
        safeSendChat(line)
        task.wait(0.8)
    end
end

-- commands
TextChatService.MessageReceived:Connect(function(message)
    pcall(function()
        local source = message.TextSource
        if not source then return end

        local sender = Players:GetPlayerByUserId(source.UserId)
        if not sender or not isAuthorized(sender) then return end

        local text = message.Text:lower():match("^%s*(.-)%s*$")

        if text == "!dumptools" then
            dumpTools()
            return
        end

        if not isBot(LocalPlayer) or isCommander(LocalPlayer) then return end

        if text == STOP_COMMAND then
            if busy then
                stopRequested = true
            end
        elseif text == "!mods" or text:match("^!mod%s+.+$") or text:match("^!unmod%s+.+$") then
            handleModCommand(sender, text)
        elseif text == "!repair" or text:match("^!repair%s+.+$") then
            startRepair(text:match("^!repair%s*(.-)$"))
        elseif text == "!commands" then
            if isLeaderBot() then
                task.spawn(sayCommands)
            end
        elseif text == COUNT_COMMAND then
            local total = countBricks(sender)
            safeSendChat(sender.Name .. " has placed " .. tostring(total) .. " bricks")
        else
            local saveArg = text:match("^!save%s+(.+)$")
            local loadArg = text:match("^!load%s+(.+)$")
            if saveArg then
                local nameText, targetText = saveArg:match("^(.-)%s+from%s+(.+)$")
                local name = cleanName(nameText or saveArg)
                local ownerName = sender.Name
                if name and targetText then
                    local query = targetText:match("^%s*@?(.-)%s*$")
                    local target = findPlayerByQuery(query)
                    ownerName = target and target.Name or query
                end
                if name and ownerName ~= "" then
                    local total = saveBuild(name, ownerName)
                    if total > 0 then
                        safeSendChat("Saved '" .. name .. "' from " .. ownerName .. " (" .. total .. " bricks)")
                    else
                        safeSendChat("No bricks to save for " .. ownerName)
                    end
                end
            elseif loadArg then
                local name = cleanName(loadArg)
                if name then
                    loadBuild(name)
                end
            else
                local deleteArg = text:match("^!deletesavebuild%s+(.+)$")
                if deleteArg then
                    deleteArg = deleteArg:match("^%s*(.-)%s*$")
                    if deleteArg == "all" then
                        local count = deleteAllSaves()
                        safeSendChat("Deleted all saves (" .. count .. "), protected ones were kept")
                    else
                        local name = cleanName(deleteArg)
                        if name then
                            if PROTECTED_SAVES[name] then
                                safeSendChat("'" .. name .. "' is protected and can't be deleted")
                            elseif deleteSave(name) then
                                safeSendChat("Deleted save '" .. name .. "'")
                            else
                                safeSendChat("No save called '" .. name .. "'")
                            end
                        end
                    end
                end
            end
        end
    end)
end)
